# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Same project URL + the public "anon" key — used only for login (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Show "Continue with Google" once the Google provider is enabled in Supabase → Authentication → Providers
# NEXT_PUBLIC_GOOGLE_LOGIN=true

# Razorpay → Account & Settings → API Keys (use rzp_test_… keys locally)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# Razorpay → Webhooks → secret you choose (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=xxx

# Local testing only: publish without paying when Razorpay keys are missing. Never set in production.
# INVITES_FREE_PUBLISH=true

# Public site URL (share links, sitemap, link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
